{
  "name": "where-is-the-tax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "validate:data": "node --experimental-strip-types scripts/validate-data.ts --root data",
    "validate:fixture": "node --experimental-strip-types scripts/validate-data.ts --root tests/fixtures/valid --allow-synthetic"
  },
  "dependencies": {
    "d3-dsv": "^3.0.1"
  },
  "devDependencies": {
    "@types/d3-dsv": "^3.0.7",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
